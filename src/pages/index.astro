---
import BaseLayout from "../layouts/BaseLayout.astro";
import QuizCard from "../components/QuizCard.astro";
import Mascot from "../components/Mascot.astro";
---

<BaseLayout title="Daily Trivia Sprint — A Fresh 60-Question Challenge, Every Day">
  <main class="wrap home-grid">
    <section class="home-intro">
      <p class="tagline">
        Are you a <strong>Trivia Sprinter</strong>, or more of a <strong>casual browser</strong>?
      </p>
      <h2 class="serif">Let's Play!</h2>
      <QuizCard />
    </section>

    <aside class="home-side">
      <h1 class="serif">
        Sprint Through Knowledge: <br />The 60-Question Challenge
      </h1>
      <Mascot className="mascot-hero" />
      <p class="side-copy">
        Every round on Daily Trivia Sprint is a quick 60-question circuit, split into
        four bite-sized heats of 15. Answer at your own pace, track your streak, and
        come back tomorrow for a brand-new set.
      </p>
      <p class="side-copy">
        No accounts required to play a round as a guest &mdash; register if you'd
        like your score and history saved between visits.
      </p>
      <div class="ad-slot ad-side" style="width:300px;height:600px;">
        <span aria-hidden="true">Advertisement</span>
      </div>
    </aside>
  </main>

  <section class="wrap signup-band">
    <h2 class="serif">Never miss a sprint.</h2>
    <p>
      Join the list and we'll ping you when a new 60-question round goes live &mdash;
      plus the occasional note when we shake up the format.
    </p>
    <a class="btn btn-primary" href="/hello">Join the list</a>
  </section>

  <style>
    .home-grid {
      display: grid;
      grid-template-columns: 1.1fr 0.9fr;
      gap: 48px;
      padding-top: 40px;
      padding-bottom: 40px;
    }
    @media (max-width: 860px) {
      .home-grid {
        grid-template-columns: 1fr;
      }
    }
    .tagline {
      color: var(--ink-soft);
    }
    .home-side h1 {
      font-size: 2.3rem;
      line-height: 1.25;
      margin-top: 0;
      font-weight: 600;
    }
    .mascot-hero {
      width: 150px;
      height: auto;
      display: block;
      margin: 10px 0 20px;
    }
    .side-copy {
      color: var(--ink-soft);
      max-width: 42ch;
    }
    .ad-slot {
      display: flex;
      align-items: center;
      justify-content: center;
      background: var(--cream-light);
      border: 1px dashed var(--border);
      color: var(--ink-soft);
      font-size: 0.8rem;
      margin-top: 20px;
    }
    .signup-band {
      background: var(--cream);
      border-radius: var(--radius);
      padding: 36px 32px;
      margin-bottom: 60px;
      text-align: center;
    }
    .signup-band p {
      max-width: 48ch;
      margin: 10px auto 20px;
      color: var(--ink-soft);
    }
  </style>
</BaseLayout>
